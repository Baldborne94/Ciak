# ── TMDB (lato server, MAI esposta al browser) ─────────────────────────
# Crea un account su https://www.themoviedb.org e genera una API key (v3).
# Niente prefisso VITE_: il browser passa da /api/tmdb, che la tiene qui.
# Con VITE_ finirebbe nel bundle, copiabile da chiunque apra i devtools.
TMDB_API_KEY=your_tmdb_api_key_here

# ── Supabase ───────────────────────────────────────────────────────────
# Da Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Anthropic (lato server, MAI esposta al browser) ────────────────────
# Usata SOLO dalla serverless function in /api. Niente prefisso VITE_.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Notifiche push (Web Push) ──────────────────────────────────────────
# Genera le chiavi VAPID: `npx web-push generate-vapid-keys`
# La PUBLIC va sia al client (VITE_) sia al server; la PRIVATE solo al server.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:tu@esempio.com

# ── Google Drive (funzione "I miei film") ──────────────────────────────
# Streaming dei tuoi film tenuti su Google Drive. Serve un OAuth Client ID
# (tipo "Applicazione web") da Google Cloud Console → Credenziali, con la
# Google Drive API abilitata e la tua email fra gli "utenti di prova".
# È PUBBLICO (nessun segreto lato client): il prefisso VITE_ è corretto.
# Se assente, la funzione resta nascosta e il resto dell'app non cambia.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── OpenSubtitles (lato server, sottotitoli del lettore di Ciak) ───────
# Quando accanto al film su Drive non c'è un .srt, Ciak lo cerca qui e lo
# salva nella cartella. Chiave: https://www.opensubtitles.com/consumers
# (account gratuito). Username e password sono facoltativi ma alzano il tetto
# di download giornaliero rispetto alla sola chiave. Se la chiave manca, Ciak
# usa solo i sottotitoli che trova su Drive.
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# ── TheIntroDB (lato server, tempi di sigla e titoli di coda) ──────────
# I tempi esatti di sigla e titoli di coda, episodio per episodio. Si legge
# senza chiave; questa è facoltativa, da mettere solo se TheIntroDB
# rifiutasse le richieste (403). Chiave gratuita: https://theintrodb.org
THEINTRODB_API_KEY=

# (tabella ai_usage, vedi supabase/schema_v9_ai_usage.sql). Service role.
# Da Supabase → Project Settings → API → service_role (segreta!).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Opzionale: protegge l'endpoint cron.
CRON_SECRET=any_random_string

# ── Limite usi AI ──────────────────────────────────────────────────────
# Usi AI per utente al giorno. Default 3. Tieni i due valori allineati.
AI_DAILY_LIMIT=3          # server (lo applica davvero)
VITE_AI_DAILY_LIMIT=3     # client (solo per mostrare "usi rimasti")
