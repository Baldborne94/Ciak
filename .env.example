# ── TMDB (The Movie Database) ──────────────────────────────────────────
# Crea un account su https://www.themoviedb.org e genera una API key (v3).
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# ── Supabase ───────────────────────────────────────────────────────────
# Da Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Anthropic (lato server, MAI esposta al browser) ────────────────────
# Usata SOLO dalla serverless function in /api. Niente prefisso VITE_.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Notifiche push (Web Push) ──────────────────────────────────────────
# Genera le chiavi VAPID: `npx web-push generate-vapid-keys`
# La PUBLIC va sia al client (VITE_) sia al server; la PRIVATE solo al server.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:tu@esempio.com

# Per il cron che invia le push (legge tutte le righe → service role).
# Da Supabase → Project Settings → API → service_role (segreta!).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Opzionale: protegge l'endpoint cron.
CRON_SECRET=any_random_string
