# ─── CineVault — variabili d'ambiente ───────────────────────────────
# Copia questo file in ".env" e compila i valori.
# Le variabili VITE_* sono esposte al browser (NON metterci segreti server-side).

# ─── Supabase ───────────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─── TMDB (The Movie Database) ──────────────────────────────────────
# Registrati su https://www.themoviedb.org → Settings → API
# Usa il "API Read Access Token" (v4 bearer) — consigliato
VITE_TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# ─── Anthropic (raccomandazioni AI) ─────────────────────────────────
# ATTENZIONE: questa chiave è SERVER-SIDE. NON usare il prefisso VITE_.
# Viene letta solo dalla serverless function in /api su Vercel.
ANTHROPIC_API_KEY=your-anthropic-api-key
